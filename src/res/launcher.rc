#include <windows.h>

1 ICON "app_icon.ico"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments",         "Launcher and Configuration Utility for Prince of Persia: Shadow and the Flame - Reignited"
            VALUE "CompanyName",      "PoP SnF Community"
            VALUE "FileDescription",  "Prince of Persia: Shadow and the Flame - Reignited - Launcher"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "PoPSnF_Launcher"
            VALUE "LegalCopyright",   "Ubisoft"
            VALUE "OriginalFilename", "PoPSnF_Launcher.exe"
            VALUE "ProductName",      "Prince of Persia: Shadow and the Flame - Reignited"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
